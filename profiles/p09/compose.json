{
  "name": "${P09_NAMESPACE:?P09_NAMESPACE required}",
  "services": {
    "database": {
      "image": "docker.io/library/postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea",
      "environment": {
        "POSTGRES_DB": "directus",
        "POSTGRES_USER": "directus",
        "POSTGRES_PASSWORD": "${P09_DB_PASSWORD:?private password required}"
      },
      "volumes": [
        "db_data:/var/lib/postgresql/data"
      ],
      "networks": [
        "lab"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U directus -d directus"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20
      }
    },
    "directus": {
      "image": "docker.io/directus/directus:12.5.0@sha256:7de5d6898b955dab1672619aed590035dcade4f8d7396d913e55543e114d1331",
      "depends_on": {
        "database": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "DB_CLIENT": "pg",
        "DB_HOST": "database",
        "DB_PORT": "5432",
        "DB_DATABASE": "directus",
        "DB_USER": "directus",
        "DB_PASSWORD": "${P09_DB_PASSWORD:?required}",
        "KEY": "${P09_KEY:?required}",
        "SECRET": "${P09_SECRET:?required}",
        "ADMIN_EMAIL": "admin@example.com",
        "ADMIN_PASSWORD": "${P09_ADMIN_PASSWORD:?required}",
        "LICENSE_KEY": "${P09_LICENSE_KEY:-}",
        "PUBLIC_URL": "http://127.0.0.1:18055",
        "TELEMETRY": "false",
        "CACHE_ENABLED": "false",
        "RATE_LIMITER_ENABLED": "false",
        "ACCESS_TOKEN_TTL": "2h"
      },
      "ports": [
        "127.0.0.1:18055:8055"
      ],
      "volumes": [
        "uploads:/directus/uploads",
        "extensions:/directus/extensions"
      ],
      "networks": [
        "lab"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "require('http').get('http://127.0.0.1:8055/server/ping',r=>{r.resume();process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "20s"
      }
    },
    "runner": {
      "image": "docker.io/schemathesis/schemathesis:4.30.0@sha256:bb9cecfc9ac4058a15fcf9b505d9d9f972e2dde7c74c4e9289a35922f4cbc0a5",
      "profiles": [
        "cli"
      ],
      "networks": [
        "lab"
      ],
      "entrypoint": [
        "schemathesis"
      ],
      "command": [
        "--version"
      ]
    }
  },
  "networks": {
    "lab": {
      "name": "${P09_NAMESPACE}_network",
      "labels": {
        "damh.phase": "P09",
        "damh.namespace": "${P09_NAMESPACE}"
      }
    }
  },
  "volumes": {
    "db_data": {
      "name": "${P09_NAMESPACE}_db_data",
      "labels": {
        "damh.phase": "P09",
        "damh.namespace": "${P09_NAMESPACE}"
      }
    },
    "uploads": {
      "name": "${P09_NAMESPACE}_uploads",
      "labels": {
        "damh.phase": "P09",
        "damh.namespace": "${P09_NAMESPACE}"
      }
    },
    "extensions": {
      "name": "${P09_NAMESPACE}_extensions",
      "labels": {
        "damh.phase": "P09",
        "damh.namespace": "${P09_NAMESPACE}"
      }
    }
  }
}
