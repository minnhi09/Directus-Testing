{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://damh.invalid/coverage/1.0.0/system-inventory.schema.json",
  "title": "One inventory JSONL record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "data_origin": {
      "enum": [
        "DESIGN_EXAMPLE",
        "OBSERVATION",
        "DERIVED"
      ]
    },
    "inventory_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "inventory_revision": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "module_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "capability_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "transport": {
      "$ref": "common.schema.json#/$defs/transport"
    },
    "method": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/method"
        },
        {
          "type": "null"
        }
      ]
    },
    "path_template": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/path"
        },
        {
          "type": "null"
        }
      ]
    },
    "protocol_operation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_key": {
      "type": "string",
      "minLength": 1
    },
    "route_variant": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "feature_profile": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "feature_flag": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "deployed_state": {
      "enum": [
        "ENABLED_VERIFIED",
        "DISABLED_VERIFIED",
        "UNKNOWN"
      ]
    },
    "scope_tier": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "applicability": {
      "$ref": "common.schema.json#/$defs/applicability"
    },
    "decision_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "oas_state": {
      "enum": [
        "PRESENT",
        "SOURCE_ONLY",
        "OAS_ONLY",
        "UNKNOWN"
      ]
    },
    "oas_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "data_origin",
    "inventory_id",
    "inventory_revision",
    "module_id",
    "capability_id",
    "transport",
    "method",
    "path_template",
    "protocol_operation",
    "operation_key",
    "route_variant",
    "feature_profile",
    "feature_flag",
    "deployed_state",
    "scope_tier",
    "applicability",
    "decision_id",
    "source_refs",
    "gap_ids",
    "oas_state",
    "oas_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "applicability": {
            "const": "NOT_APPLICABLE"
          }
        },
        "required": [
          "applicability"
        ]
      },
      "then": {
        "properties": {
          "decision_id": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "applicability"
        ]
      },
      "then": {
        "properties": {
          "gap_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "const": "REST"
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "$ref": "common.schema.json#/$defs/method"
          },
          "path_template": {
            "$ref": "common.schema.json#/$defs/path"
          },
          "protocol_operation": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport": {
            "not": {
              "const": "REST"
            }
          }
        },
        "required": [
          "transport"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "type": "null"
          },
          "path_template": {
            "type": "null"
          },
          "protocol_operation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployed_state": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "deployed_state"
        ]
      },
      "then": {
        "properties": {
          "gap_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "oas_state": {
            "const": "PRESENT"
          }
        },
        "required": [
          "oas_state"
        ]
      },
      "then": {
        "properties": {
          "oas_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "oas_state": {
            "enum": [
              "SOURCE_ONLY",
              "OAS_ONLY",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "oas_state"
        ]
      },
      "then": {
        "properties": {
          "gap_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
