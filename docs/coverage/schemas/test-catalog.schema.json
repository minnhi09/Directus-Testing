{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://damh.invalid/coverage/1.0.0/test-catalog.schema.json",
  "title": "One canonical test JSONL record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "data_origin": {
      "enum": [
        "DESIGN_EXAMPLE",
        "OBSERVATION",
        "DERIVED"
      ]
    },
    "canonical_test_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "catalog_revision": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "legacy_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "operation_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "test_type": {
      "enum": [
        "SCENARIO",
        "CONTRACT",
        "PROPERTY",
        "STATEFUL",
        "AUTHORIZATION",
        "BOUNDARY",
        "PARTITION",
        "UI",
        "INTEGRATION",
        "UNIT",
        "OTHER"
      ]
    },
    "input_partition": {
      "type": "string",
      "minLength": 1
    },
    "fixture_profile": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "oracle_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "automation_state": {
      "enum": [
        "MANUAL",
        "PLANNED",
        "IMPLEMENTED",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "owner": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "cleanup_ref": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/sourceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonical_test_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "test_version": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "canonical_test_id",
          "test_version",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "data_origin",
    "canonical_test_id",
    "version",
    "catalog_revision",
    "aliases",
    "legacy_ids",
    "requirement_ids",
    "operation_ids",
    "test_type",
    "input_partition",
    "fixture_profile",
    "oracle_refs",
    "automation_state",
    "owner",
    "prerequisites",
    "cleanup_ref",
    "derived_from",
    "source_refs",
    "gap_ids"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "oracle_refs": {
            "maxItems": 0
          }
        },
        "required": [
          "oracle_refs"
        ]
      },
      "then": {
        "properties": {
          "gap_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "fixture_profile": {
                "type": "null"
              }
            },
            "required": [
              "fixture_profile"
            ]
          },
          {
            "properties": {
              "cleanup_ref": {
                "type": "null"
              }
            },
            "required": [
              "cleanup_ref"
            ]
          },
          {
            "properties": {
              "automation_state": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "automation_state"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "gap_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
