{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://damh.invalid/coverage/1.0.0/common.schema.json",
  "title": "DAMH coverage shared types v1.0.0",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "transport": {
      "enum": [
        "REST",
        "GRAPHQL",
        "WEBSOCKET",
        "UI",
        "CLI",
        "SCHEDULER",
        "INTEGRATION"
      ]
    },
    "method": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS",
        "TRACE",
        "CONNECT"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9_.~-]+|\\{[A-Za-z_][A-Za-z0-9_]*\\})(?:/(?:[A-Za-z0-9_.~-]+|\\{[A-Za-z_][A-Za-z0-9_]*\\}))*$|^/$"
    },
    "scope": {
      "enum": [
        "CORE",
        "EXTENDED",
        "CONDITIONAL"
      ]
    },
    "applicability": {
      "enum": [
        "APPLICABLE",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "INCOMPLETE",
        "NOT_APPLICABLE"
      ]
    },
    "cleanup": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "INCOMPLETE",
        "NOT_REQUIRED",
        "UNKNOWN"
      ]
    },
    "infrastructure": {
      "enum": [
        "HEALTHY",
        "DEGRADED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "unit": {
      "enum": [
        "REQUIREMENT",
        "REST_OPERATION",
        "PROTOCOL_OPERATION",
        "MODULE",
        "AUTHORIZATION_RULE",
        "CODE_STATEMENT",
        "CODE_LINE",
        "CODE_FUNCTION",
        "CODE_BRANCH",
        "SCHEMA_PARAMETER",
        "SCHEMA_KEYWORD",
        "SCHEMA_RESPONSE"
      ]
    },
    "gapMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "sourceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "GIT_FILE",
            "ARTIFACT",
            "DESIGN"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "pointer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^#"
            },
            {
              "type": "null"
            }
          ]
        },
        "certainty": {
          "enum": [
            "VERIFIED",
            "HISTORICAL",
            "PROPOSED",
            "UNKNOWN"
          ]
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "path",
        "revision",
        "sha256",
        "pointer",
        "certainty",
        "gap_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "GIT_FILE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "revision": {
                "$ref": "common.schema.json#/$defs/sha"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ARTIFACT"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "sha256": {
                "$ref": "common.schema.json#/$defs/hash"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "certainty": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "certainty"
            ]
          },
          "then": {
            "properties": {
              "gap_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "policy_profile": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor_id",
        "policy_profile"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "measurement_status": {
          "enum": [
            "MEASURED",
            "NOT_MEASURED"
          ]
        },
        "unit": {
          "$ref": "common.schema.json#/$defs/unit"
        },
        "numerator_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "denominator_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "missing_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "numerator_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "denominator_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "percentage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "measurement_status",
        "unit",
        "numerator_ids",
        "denominator_ids",
        "missing_ids",
        "numerator_count",
        "denominator_count",
        "percentage",
        "gap_ids",
        "evidence_refs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "measurement_status": {
                "const": "NOT_MEASURED"
              }
            },
            "required": [
              "measurement_status"
            ]
          },
          "then": {
            "properties": {
              "numerator_count": {
                "type": "null"
              },
              "denominator_count": {
                "type": "null"
              },
              "percentage": {
                "type": "null"
              },
              "gap_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_status": {
                "const": "MEASURED"
              }
            },
            "required": [
              "measurement_status"
            ]
          },
          "then": {
            "properties": {
              "numerator_count": {
                "type": "integer",
                "minimum": 0
              },
              "denominator_count": {
                "type": "integer",
                "minimum": 1
              },
              "percentage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "operationEvidence": {
      "type": "object",
      "properties": {
        "inventory_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "actor": {
          "$ref": "common.schema.json#/$defs/actor"
        },
        "dispatch_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "positive_acceptance": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "read_back_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "read_back_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "request_ref": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "response_ref": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "read_back_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "inventory_id",
        "actor",
        "dispatch_verified",
        "positive_acceptance",
        "read_back_required",
        "read_back_verified",
        "request_ref",
        "response_ref",
        "read_back_refs",
        "gap_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dispatch_verified": {
                "const": true
              }
            },
            "required": [
              "dispatch_verified"
            ]
          },
          "then": {
            "properties": {
              "request_ref": {
                "$ref": "common.schema.json#/$defs/sourceRef"
              },
              "response_ref": {
                "$ref": "common.schema.json#/$defs/sourceRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "positive_acceptance": {
                "const": true
              }
            },
            "required": [
              "positive_acceptance"
            ]
          },
          "then": {
            "properties": {
              "dispatch_verified": {
                "const": true
              },
              "request_ref": {
                "$ref": "common.schema.json#/$defs/sourceRef"
              },
              "response_ref": {
                "$ref": "common.schema.json#/$defs/sourceRef"
              },
              "read_back_required": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "positive_acceptance": {
                "const": true
              },
              "read_back_required": {
                "const": true
              }
            },
            "required": [
              "positive_acceptance",
              "read_back_required"
            ]
          },
          "then": {
            "properties": {
              "read_back_verified": {
                "const": true
              },
              "read_back_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "assertionResult": {
      "type": "object",
      "properties": {
        "assertion_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "dimension": {
          "enum": [
            "BUSINESS",
            "CONTRACT",
            "AUTHORIZATION",
            "INVARIANT"
          ]
        },
        "mandatory": {
          "type": "boolean"
        },
        "oracle_ref": {
          "$ref": "common.schema.json#/$defs/sourceRef"
        },
        "verdict": {
          "$ref": "common.schema.json#/$defs/verdict"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "finding_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assertion_id",
        "requirement_ids",
        "dimension",
        "mandatory",
        "oracle_ref",
        "verdict",
        "evidence_refs",
        "finding_id"
      ],
      "additionalProperties": false
    }
  }
}
