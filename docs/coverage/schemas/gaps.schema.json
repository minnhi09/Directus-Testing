{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://damh.invalid/coverage/1.0.0/gaps.schema.json",
  "title": "One gap JSONL record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "data_origin": {
      "enum": [
        "DESIGN_EXAMPLE",
        "OBSERVATION",
        "DERIVED"
      ]
    },
    "gap_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "target_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "owner": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "approved_by": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "due_milestone": {
      "anyOf": [
        {
          "enum": [
            "M1",
            "M2",
            "M3"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "OPEN",
        "IN_PROGRESS",
        "RESOLVED",
        "DEFERRED"
      ]
    },
    "blocking": {
      "type": "boolean"
    },
    "resolution_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "decision_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "data_origin",
    "gap_id",
    "target_ids",
    "reason",
    "source_refs",
    "owner",
    "approved_by",
    "date",
    "due_milestone",
    "gap_ids",
    "status",
    "blocking",
    "resolution_refs",
    "decision_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "RESOLVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resolution_refs": {
            "minItems": 1
          },
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DEFERRED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "decision_id": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    }
  ]
}
