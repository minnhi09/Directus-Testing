{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://damh.invalid/coverage/1.1.0/assertion-scopes.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "P01_ASSERTION_SCOPES_1"
    },
    "scope_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "baseline_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "canonical_test_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "test_version": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "requirement_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "mandatory_dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "BUSINESS",
                "CONTRACT",
                "AUTHORIZATION",
                "INVARIANT"
              ]
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/sourceRef"
            }
          }
        },
        "required": [
          "canonical_test_id",
          "test_version",
          "requirement_id",
          "mandatory_dimensions",
          "source_refs"
        ]
      }
    }
  },
  "required": [
    "format",
    "scope_id",
    "baseline_id",
    "entries"
  ]
}
