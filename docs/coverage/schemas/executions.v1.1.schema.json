{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://damh.invalid/coverage/1.1.0/executions.schema.json",
  "title": "Execution evidence v1.1.0: oracle-scoped mandatory dimensions",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "data_origin": {
      "enum": [
        "DESIGN_EXAMPLE",
        "OBSERVATION",
        "DERIVED"
      ]
    },
    "execution_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "baseline_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "canonical_test_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "test_version": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "retry_of_execution_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "flaky": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "execution_status": {
      "$ref": "common.schema.json#/$defs/verdict"
    },
    "business_verdict": {
      "$ref": "common.schema.json#/$defs/verdict"
    },
    "contract_verdict": {
      "$ref": "common.schema.json#/$defs/verdict"
    },
    "tool_status": {
      "enum": [
        "PASSED",
        "FAILED",
        "ERROR",
        "NOT_RUN",
        "UNKNOWN"
      ]
    },
    "tool_exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "completion_status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "NOT_STARTED",
        "UNKNOWN"
      ]
    },
    "stop_reason": {
      "enum": [
        "COMPLETED",
        "MAX_TIME",
        "TIMEOUT",
        "CANCELLED",
        "PRECONDITION_FAILED",
        "ERROR",
        "EVIDENCE_MISSING",
        "NOT_STARTED",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ]
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/operationEvidence"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "assertion_results": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/assertionResult"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "cleanup_status": {
      "$ref": "common.schema.json#/$defs/cleanup"
    },
    "cleanup_evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sourceRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "infrastructure_status": {
      "$ref": "common.schema.json#/$defs/infrastructure"
    },
    "finding_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "legacy_status": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "decision_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "assertion_scope_id": {
      "$ref": "common.schema.json#/$defs/id"
    }
  },
  "required": [
    "schema_version",
    "data_origin",
    "execution_id",
    "run_id",
    "baseline_id",
    "canonical_test_id",
    "test_version",
    "attempt",
    "retry_of_execution_id",
    "flaky",
    "execution_status",
    "business_verdict",
    "contract_verdict",
    "tool_status",
    "tool_exit_code",
    "completion_status",
    "stop_reason",
    "started_at",
    "finished_at",
    "operation_evidence",
    "assertion_results",
    "evidence_refs",
    "cleanup_status",
    "cleanup_evidence_refs",
    "infrastructure_status",
    "finding_id",
    "gap_ids",
    "legacy_status",
    "notes",
    "decision_id",
    "assertion_scope_id"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "PASS"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "completion_status": {
            "const": "COMPLETE"
          },
          "cleanup_status": {
            "enum": [
              "PASS",
              "NOT_REQUIRED"
            ]
          },
          "assertion_results": {
            "minItems": 1,
            "items": {
              "if": {
                "properties": {
                  "mandatory": {
                    "const": true
                  }
                },
                "required": [
                  "mandatory"
                ]
              },
              "then": {
                "properties": {
                  "verdict": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "NOT_RUN"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "started_at": {
            "type": "null"
          },
          "finished_at": {
            "type": "null"
          },
          "completion_status": {
            "const": "NOT_STARTED"
          },
          "business_verdict": {
            "const": "NOT_RUN"
          },
          "contract_verdict": {
            "const": "NOT_RUN"
          },
          "tool_status": {
            "const": "NOT_RUN"
          },
          "tool_exit_code": {
            "type": "null"
          },
          "operation_evidence": {
            "maxItems": 0
          },
          "assertion_results": {
            "maxItems": 0
          },
          "cleanup_status": {
            "enum": [
              "NOT_RUN",
              "NOT_REQUIRED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_origin": {
            "enum": [
              "OBSERVATION",
              "DERIVED"
            ]
          },
          "execution_status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCOMPLETE"
            ]
          }
        },
        "required": [
          "data_origin",
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "started_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cleanup_status": {
            "const": "PASS"
          }
        },
        "required": [
          "cleanup_status"
        ]
      },
      "then": {
        "properties": {
          "cleanup_evidence_refs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completion_status": {
            "const": "INCOMPLETE"
          }
        },
        "required": [
          "completion_status"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "not": {
              "const": "PASS"
            }
          },
          "stop_reason": {
            "enum": [
              "MAX_TIME",
              "TIMEOUT",
              "CANCELLED",
              "ERROR",
              "EVIDENCE_MISSING",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "NOT_APPLICABLE"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "decision_id": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_origin": {
            "enum": [
              "OBSERVATION",
              "DERIVED"
            ]
          },
          "completion_status": {
            "const": "COMPLETE"
          },
          "execution_status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        },
        "required": [
          "data_origin",
          "completion_status",
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "finished_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        }
      }
    }
  ]
}
