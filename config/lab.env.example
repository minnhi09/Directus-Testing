# Copy this file to config/lab.env and replace every REPLACE_* value locally.
# config/lab.env is ignored by Git and must never be committed.

DIRECTUS_IMAGE=docker.io/directus/directus:12.5.0@sha256:7de5d6898b955dab1672619aed590035dcade4f8d7396d913e55543e114d1331
POSTGRES_IMAGE=docker.io/library/postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
SCHEMATHESIS_IMAGE=docker.io/schemathesis/schemathesis:4.30.0@sha256:bb9cecfc9ac4058a15fcf9b505d9d9f972e2dde7c74c4e9289a35922f4cbc0a5

DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
DIRECTUS_KEY=REPLACE_WITH_LOCAL_KEY
DIRECTUS_SECRET=REPLACE_WITH_LOCAL_SECRET_AT_LEAST_32_BYTES
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
# Optional for the Reader custom permission policy. Never commit the real key.
LICENSE_KEY=REPLACE_WITH_LOCAL_LICENSE_KEY
ACCESS_TOKEN_TTL=2h

# Optional URL overrides. Keep the host API loopback-only for the lab.
API_URL=http://127.0.0.1:8055
RUNNER_API_URL=http://directus:8055

# API actors created by the seed step. These values stay in config/lab.env.
EDITOR_EMAIL=editor@example.com
EDITOR_PASSWORD=REPLACE_WITH_LOCAL_EDITOR_PASSWORD
READER_EMAIL=reader@example.com
READER_PASSWORD=REPLACE_WITH_LOCAL_READER_PASSWORD

# Campaign defaults are also overridable for a short local verification, for
# example: LAB_CAMPAIGN_SEEDS=101 LAB_MAX_EXAMPLES=2 LAB_MAX_TIME=30 ./lab.sh test raw
# Keep the planned values for a full run; every value is written to campaign-summary.json.
LAB_CAMPAIGN_SEEDS=101,202,303
LAB_MAX_TIME=1200
LAB_MAX_EXAMPLES=100
LAB_WORKERS=1
LAB_RATE_LIMIT=5/s
LAB_REQUEST_TIMEOUT=10
